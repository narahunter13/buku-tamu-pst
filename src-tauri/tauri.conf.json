{
	"$schema": "../gen/schemas/desktop-schema.json",
	"productName": "Buku Tamu PST",
	"version": "0.1.0",
	"identifier": "com.bps.bukutamu",
	"build": {
		"frontendDist": "../build",
		"devUrl": "http://127.0.0.1:1420",
		"beforeDevCommand": "pnpm dev",
		"beforeBuildCommand": "pnpm build"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Buku Tamu PST",
				"width": 1280,
				"height": 800,
				"minWidth": 1024,
				"minHeight": 600,
				"fullscreen": false,
				"maximized": true,
				"resizable": true,
				"maximizable": false,
				"minimizable": true,
				"closable": true,
				"decorations": false,
				"center": true,
				"visible": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"windows": {
			"nsis": {
				"displayLanguageSelector": false
			},
			"webviewInstallMode": {
				"type": "downloadBootstrapper",
				"silent": true
			}
		}
	}
}
